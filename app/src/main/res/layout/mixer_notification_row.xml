<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the expanded notification: icon, name and level bar, percent, - and + buttons.
     RemoteViews can't host a SeekBar, hence the buttons; the slider lives in MixerActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/mixer_text"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/level"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:indeterminate="false"
            android:max="200"
            android:progressBackgroundTint="@color/mixer_track"
            android:progressTint="@color/mixer_accent" />
    </LinearLayout>

    <TextView
        android:id="@+id/percent"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:singleLine="true"
        android:textColor="@color/mixer_text_secondary"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/down"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/mixer_button_bg"
        android:scaleType="center"
        android:src="@drawable/ic_remove" />

    <ImageButton
        android:id="@+id/up"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/mixer_button_bg"
        android:scaleType="center"
        android:src="@drawable/ic_add" />
</LinearLayout>
