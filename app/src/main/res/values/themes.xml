<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main screen: the page has its own heading, so no title bar. -->
    <style name="Theme.MultiAppAudio" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    </style>

    <!-- App volume panel: a sheet drawn over whatever app is open. The activity animates the
         sheet itself, so the window has no background or animation of its own. -->
    <style name="Theme.MultiAppAudio.Mixer" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
